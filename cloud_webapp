:root {
  --bg-gradient: radial-gradient(circle at 50% 20%, #1e1b4b 0%, #0f172a 50%, #030712 100%);
  --accent-cyan: #38bdf8;
  --accent-violet: #818cf8;
  --accent-glow: rgba(56, 189, 248, 0.4);
  --card-bg: rgba(255, 255, 255, 0.05);
  --card-border: rgba(255, 255, 255, 0.1);
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --danger: #ef4444;
  --danger-glow: rgba(239, 68, 68, 0.5);
  --success: #10b981;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

body {
  font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg-gradient);
  color: var(--text-main);
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}

.call-container {
  width: 100%;
  max-width: 480px;
  height: 100%;
  max-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24px 20px env(safe-area-inset-bottom, 24px) 20px;
  position: relative;
}

/* Header */
.call-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 40px;
}

.caller-meta {
  display: flex;
  align-items: center;
  gap: 10px;
}

.live-dot {
  width: 10px;
  height: 10px;
  background-color: var(--success);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--success);
  animation: pulse-dot 1.8s infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.connection-status {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.3px;
  color: #e2e8f0;
}

.call-timer {
  font-size: 14px;
  font-weight: 600;
  color: var(--accent-cyan);
  background: rgba(56, 189, 248, 0.1);
  padding: 4px 10px;
  border-radius: 20px;
  font-variant-numeric: tabular-nums;
}

/* Body & Pulsing Avatar */
.call-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 16px 0;
}

.avatar-wrapper {
  position: relative;
  width: 180px;
  height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.avatar-box {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f46e5, #06b6d4);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 30px var(--accent-glow);
  position: relative;
  z-index: 5;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.avatar-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #ffffff;
}

.athena-icon {
  width: 44px;
  height: 44px;
}

.avatar-name {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
}

.pulse-ring {
  position: absolute;
  border-radius: 50%;
  border: 1.5px solid var(--accent-cyan);
  opacity: 0;
  pointer-events: none;
}

/* Animation states */
.speaking .ring-1 {
  width: 150px;
  height: 150px;
  animation: ripple 2s cubic-bezier(0.1, 0.8, 0.3, 1) infinite;
}

.speaking .ring-2 {
  width: 180px;
  height: 180px;
  animation: ripple 2s cubic-bezier(0.1, 0.8, 0.3, 1) 0.6s infinite;
}

.speaking .ring-3 {
  width: 210px;
  height: 210px;
  animation: ripple 2s cubic-bezier(0.1, 0.8, 0.3, 1) 1.2s infinite;
}

.listening .avatar-box {
  box-shadow: 0 0 45px rgba(56, 189, 248, 0.7);
  transform: scale(1.05);
}

@keyframes ripple {
  0% { transform: scale(0.7); opacity: 0.9; }
  100% { transform: scale(1.4); opacity: 0; }
}

.bot-name {
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin-bottom: 6px;
  background: linear-gradient(135deg, #fff 40%, var(--accent-cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.bot-status {
  font-size: 14px;
  color: var(--text-muted);
  font-weight: 400;
  margin-bottom: 18px;
  text-align: center;
}

/* Visualizer Wave */
.visualizer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  height: 32px;
  margin-bottom: 20px;
}

.visualizer .bar {
  width: 4px;
  height: 6px;
  background: var(--accent-cyan);
  border-radius: 4px;
  transition: height 0.15s ease, background 0.3s;
}

.speaking .visualizer .bar {
  animation: wave 0.8s ease-in-out infinite alternate;
}

.speaking .visualizer .bar:nth-child(1) { animation-delay: 0.1s; }
.speaking .visualizer .bar:nth-child(2) { animation-delay: 0.3s; }
.speaking .visualizer .bar:nth-child(3) { animation-delay: 0.2s; }
.speaking .visualizer .bar:nth-child(4) { animation-delay: 0.4s; }
.speaking .visualizer .bar:nth-child(5) { animation-delay: 0.2s; }
.speaking .visualizer .bar:nth-child(6) { animation-delay: 0.5s; }
.speaking .visualizer .bar:nth-child(7) { animation-delay: 0.1s; }
.speaking .visualizer .bar:nth-child(8) { animation-delay: 0.3s; }
.speaking .visualizer .bar:nth-child(9) { animation-delay: 0.2s; }

@keyframes wave {
  0% { height: 6px; }
  100% { height: 28px; background: #a855f7; }
}

/* Subtitles Transcript Box */
.transcript-box {
  width: 100%;
  min-height: 80px;
  max-height: 120px;
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 18px;
  padding: 14px 18px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.transcript-message {
  font-size: 14px;
  line-height: 1.5;
  transition: opacity 0.2s ease;
}

.transcript-message.bot {
  color: #e2e8f0;
  font-style: italic;
}

.transcript-message.user {
  color: var(--accent-cyan);
  font-weight: 500;
}

/* Controls */
.call-controls {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 18px 24px;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--card-border);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 48px;
}

.control-btn {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  color: var(--text-main);
  border-radius: 50%;
  width: 60px;
  height: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
}

.control-btn:active {
  transform: scale(0.92);
}

.control-btn .btn-label {
  position: absolute;
  bottom: -22px;
  font-size: 11px;
  color: var(--text-muted);
  white-space: nowrap;
}

.control-btn.active {
  background: rgba(56, 189, 248, 0.2);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
}

.control-btn.end-call {
  background: var(--danger);
  border-color: transparent;
  color: #ffffff;
  width: 68px;
  height: 68px;
  box-shadow: 0 8px 25px var(--danger-glow);
}

.control-btn.end-call:hover {
  background: #dc2626;
}

.control-btn.end-call .btn-label {
  color: #f87171;
  font-weight: 600;
}
